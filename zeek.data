	} &default=function(i: count):string { return fmt("unknown-%d", i); };

	const os_versions: table[count, count] of string = {
		[10,0] = "Windows 10",
		[6,4]  = "Windows 10 Technical Preview",
		[6,3]  = "Windows 8.1 or Server 2012 R2",
		[6,2]  = "Windows 8 or Server 2012",
