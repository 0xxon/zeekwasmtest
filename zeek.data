		[0x2000] = "DLL",
		[0x4000] = "UP_SYSTEM_ONLY",
		[0x8000] = "BYTES_REVERSED_HI"
	} &default=function(i: count):string { return fmt("unknown-%d", i); };

	const dll_characteristics: table[count] of string = {
