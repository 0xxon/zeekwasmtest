		[5,0]  = "Windows 2000",
		[4,90] = "Windows Me",
		[4,10] = "Windows 98",
		[4,0]  = "Windows 95 or NT 4.0",
		[3,51] = "Windows NT 3.51",
		[3,50] = "Windows NT 3.5",
