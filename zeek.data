		[0x500000]   = "ALIGN_16BYTES",
		[0x600000]   = "ALIGN_32BYTES",
		[0x700000]   = "ALIGN_64BYTES",
		[0x800000]   = "ALIGN_128BYTES",
		[0x900000]   = "ALIGN_256BYTES",
		[0xa00000]   = "ALIGN_512BYTES",
